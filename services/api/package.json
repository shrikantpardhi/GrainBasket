{
  "name": "@grainbasket/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test src/*.test.ts",
    "migrate": "tsx src/migrate.ts",
    "bootstrap": "tsx src/bootstrap.ts"
  },
  "dependencies": {
    "express": "5.1.0",
    "pg": "8.16.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.16.5",
    "@types/pg": "8.15.4",
    "tsx": "4.20.3",
    "typescript": "5.9.2"
  }
}
