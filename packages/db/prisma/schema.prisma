// Grain Basket — data model.
//
// Conventions enforced everywhere below:
//   * IDs are cuid() strings.
//   * Money is Int paise. Weight is Int grams. Rates are Int basis points.
//   * Tenant-owned rows carry `shopId` even when it is reachable via a parent,
//     so the tenant extension can scope uniformly on one field.
//   * Historical rows snapshot the price/name/address at the time of the order,
//     so an old order never joins a live catalogue row that has since changed.
//
// Tenant models are listed in packages/db/src/tenant.ts. A model with a shopId
// that is missing from that map fails the model-coverage test in CI.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity — three disjoint universes
// ---------------------------------------------------------------------------

/// Platform staff. Invite-only, password + TOTP. Never a shop or customer.
model PlatformUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  totpSecret   String?
  totpEnabled  Boolean  @default(false)
  role         String // PLATFORM_ADMIN | PLATFORM_SUPPORT
  status       String   @default("ACTIVE") // ACTIVE | DISABLED
  /// Bumped to invalidate every existing session on offboarding.
  sessionVersion Int    @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions     PlatformSession[]
  invitesSent  PlatformInvite[]  @relation("PlatformInviteIssuer")

  @@index([role, status])
}

/// Store staff. Invite-only. Linked to shops through StoreMembership.
model StoreUser {
  id           String   @id @default(cuid())
  email        String?  @unique
  phone        String?  @unique
  name         String
  passwordHash String
  status       String   @default("ACTIVE") // ACTIVE | DISABLED
  sessionVersion Int    @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions      StoreSession[]
  memberships   StoreMembership[]
  invitesSent   StoreInvite[]      @relation("StoreInviteIssuer")
  millingJobs   MillingJob[]       @relation("MillingAssignee")
  stockEntries  StockLedger[]      @relation("StockActor")
  cashCollected CashCollection[]   @relation("CashCollector")

  @@index([status])
}

/// End customers. Phone + OTP. Own data only.
model Customer {
  id             String   @id @default(cuid())
  phone          String   @unique // E.164
  name           String?
  email          String?
  preferredLocale String  @default("en")
  defaultGrind   String? // FINE | MEDIUM | COARSE | WHOLE
  defaultSift    String? // SIFTED | UNSIFTED
  status         String   @default("ACTIVE") // ACTIVE | CLOSED
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sessions      CustomerSession[]
  addresses     Address[]
  carts         Cart[]
  orders        Order[]
  subscriptions Subscription[]
  redemptions   CouponRedemption[]

  @@index([phone])
  @@index([createdAt])
}

/// One row per shop a StoreUser can act in. A franchise owner holds several.
model StoreMembership {
  id           String   @id @default(cuid())
  storeUserId  String
  shopId       String
  role         String // STORE_ADMIN | STORE_STAFF | MILL_OPERATOR
  /// Extra capability keys granted on top of the role. Never used to subtract.
  capabilities String[] @default([])
  status       String   @default("ACTIVE") // ACTIVE | SUSPENDED | REMOVED
  invitedById  String?
  removedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  storeUser StoreUser @relation(fields: [storeUserId], references: [id], onDelete: Cascade)
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([storeUserId, shopId])
  @@index([shopId, status])
  @@index([storeUserId, status])
}

model PlatformInvite {
  id        String   @id @default(cuid())
  email     String
  role      String
  tokenHash String   @unique
  issuedById String?
  expiresAt DateTime
  acceptedAt DateTime?
  createdAt DateTime @default(now())

  issuedBy PlatformUser? @relation("PlatformInviteIssuer", fields: [issuedById], references: [id])

  @@index([email, acceptedAt])
}

model StoreInvite {
  id           String   @id @default(cuid())
  email        String?
  phone        String?
  shopId       String
  role         String
  capabilities String[] @default([])
  tokenHash    String   @unique
  issuedById   String?
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime @default(now())

  shop     Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  issuedBy StoreUser?  @relation("StoreInviteIssuer", fields: [issuedById], references: [id])

  @@index([shopId, acceptedAt])
}

// Sessions are three separate tables, never one with a userType column. A
// shared session table is how universe separation quietly collapses.
model PlatformSession {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model StoreSession {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user StoreUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model CustomerSession {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user Customer @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// One-shot OTP challenges. Stored hashed; never the plaintext code.
model OtpChallenge {
  id         String   @id @default(cuid())
  phone      String
  codeHash   String
  purpose    String   @default("LOGIN")
  attempts   Int      @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([phone, purpose, consumedAt])
  @@index([expiresAt])
}

model Address {
  id           String   @id @default(cuid())
  customerId   String
  label        String?
  line1        String
  line2        String?
  landmark     String?
  city         String
  state        String
  pincode      String
  lat          Float?
  lng          Float?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([pincode])
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

/// A single legal entity. GST is OPTIONAL: a shop may have none, and several
/// shops may share one entity (and therefore one GSTIN and invoice series).
model LegalEntity {
  id            String   @id @default(cuid())
  legalName     String
  tradeName     String?
  /// Null when the business is not GST-registered.
  gstin         String?
  stateCode     String?
  addressLine1  String?
  city          String?
  state         String?
  pincode       String?
  invoicePrefix String   @default("INV")
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shops    Shop[]
  invoices Invoice[]

  @@index([gstin])
}

/// A mill branch. `id` is the tenant key used by every scoped query.
model Shop {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  /// Denormalized search field: name + area + city + pincode, lowercased.
  searchText String @default("")

  description String?
  line1       String
  line2       String?
  area        String?
  city        String
  state       String
  pincode     String
  lat         Float?
  lng         Float?
  phone       String?
  email       String?

  /// Three independent status axes — see docs. A compliance pause must not
  /// stop the shop draining its milling queue.
  orderingStatus String @default("OPEN")   // OPEN | PAUSED | CLOSED
  accessStatus   String @default("ACTIVE") // ACTIVE | LOCKED
  payoutStatus   String @default("ACTIVE") // ACTIVE | HOLD

  legalEntityId String?
  timezone      String @default("Asia/Kolkata")
  taxInclusive  Boolean @default(true)
  isActive      Boolean @default(true)

  /// Per-shop order-number sequence, incremented atomically.
  orderSeq Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  legalEntity   LegalEntity?  @relation(fields: [legalEntityId], references: [id])
  settings      ShopSettings?
  categories    Category[]
  products      Product[]
  translations  ShopTranslation[]
  areas         ServiceableArea[]
  slots         DeliverySlot[]
  millSlots     MillSlot[]
  orders        Order[]
  carts         Cart[]
  memberships   StoreMembership[]
  invites       StoreInvite[]
  stockEntries  StockLedger[]
  shifts        Shift[]
  coupons       Coupon[]
  promotions    Promotion[]
  banners       Banner[]
  ledgerEntries LedgerEntry[]
  invoices      Invoice[]

  @@index([city])
  @@index([pincode])
  @@index([orderingStatus, isActive])
}

/// Shop copy in each supported locale. A missing row falls back to the shop
/// default and the UI says so rather than rendering a blank.
model ShopTranslation {
  id          String @id @default(cuid())
  shopId      String
  locale      String
  name        String
  tagline     String?
  description String?

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, locale])
  @@index([locale])
}

model ServiceableArea {
  id              String @id @default(cuid())
  shopId          String
  pincode         String
  deliveryFeePaise Int   @default(0)
  minOrderPaise   Int    @default(0)
  freeAbovePaise  Int?
  isActive        Boolean @default(true)
  createdAt       DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, pincode])
  @@index([pincode, isActive])
}

model ShopSettings {
  id                    String  @id @default(cuid())
  shopId                String  @unique
  /// Drives the customer-facing ready-time estimate.
  millThroughputGramsPerHour Int @default(60000)
  bufferMinutes         Int     @default(10)
  lastOrderLeadMinutes  Int     @default(30)
  /// Opening hours as [{dayOfWeek, opensMinute, closesMinute, closed}].
  openingHours          Json
  inPresenceCapacityPerSlot Int @default(1)
  deliveryEnabled       Boolean @default(true)
  pickupEnabled         Boolean @default(true)
  maxBannersPerSlot     Int     @default(3)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

model Category {
  id           String  @id @default(cuid())
  shopId       String
  slug         String
  name         String
  description  String?
  imageKey     String?
  sortOrder    Int     @default(0)
  isActive     Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shop         Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  translations CategoryTranslation[]
  products     Product[]

  @@unique([shopId, slug])
  @@index([shopId, isActive, sortOrder])
}

model CategoryTranslation {
  id          String @id @default(cuid())
  categoryId  String
  locale      String
  name        String
  description String?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
}

model Product {
  id              String  @id @default(cuid())
  shopId          String
  categoryId      String?
  slug            String
  name            String
  description     String?
  /// FLOUR | GRAIN | PULSE | DRY_FRUIT | OTHER
  type            String
  /// true => a milling job is created for each ordered variant.
  isMilledToOrder Boolean @default(false)
  /// Expected output/input ratio in basis points, e.g. 9800 = 98%.
  expectedYieldBps Int    @default(10000)
  imageKeys       String[] @default([])
  isActive        Boolean @default(true)
  sortOrder       Int     @default(0)
  /// Denormalized: name + description + category, lowercased, for search.
  searchText      String  @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shop        Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category    Category?            @relation(fields: [categoryId], references: [id])
  translations ProductTranslation[]
  variants    ProductVariant[]
  grindOptions ProductGrindOption[]
  promotions  Promotion[]

  @@unique([shopId, slug])
  @@index([shopId, isActive, sortOrder])
  @@index([shopId, categoryId, isActive])
  @@index([shopId, type, isActive])
}

model ProductTranslation {
  id          String @id @default(cuid())
  productId   String
  locale      String
  name        String
  description String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@index([locale])
}

/// A sellable weight of a product. `pricePerKgPaise` is authoritative;
/// `pricePaise` is recomputed from it and stored only for query convenience.
model ProductVariant {
  id                String @id @default(cuid())
  shopId            String
  productId         String
  sku               String?
  label             String // "1 kg", "5 kg"
  packWeightGrams   Int
  pricePerKgPaise   Int
  pricePaise        Int
  mrpPerKgPaise     Int?
  stockOnHandGrams  Int    @default(0)
  reservedGrams     Int    @default(0)
  lowStockGrams     Int    @default(5000)
  isActive          Boolean @default(true)
  sortOrder         Int    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  items   OrderItem[]

  // Composite key makes same-tenant relations provable in Postgres.
  @@unique([shopId, id])
  @@unique([shopId, sku])
  @@index([shopId, productId, isActive])
}

model GrindOption {
  id                     String  @id @default(cuid())
  shopId                 String
  code                   String // e.g. "fine-sifted"
  fineness               String // FINE | MEDIUM | COARSE | WHOLE
  sifted                 Boolean @default(false)
  priceDeltaPerKgPaise   Int     @default(0)
  isDefault              Boolean @default(false)
  isActive               Boolean @default(true)

  shops    ProductGrindOption[]
  items    OrderItem[]

  @@unique([shopId, code])
  @@index([shopId, isActive])
}

model ProductGrindOption {
  id            String @id @default(cuid())
  shopId        String
  productId     String
  grindOptionId String
  sortOrder     Int    @default(0)

  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  grindOption GrindOption @relation(fields: [grindOptionId], references: [id], onDelete: Cascade)

  @@unique([productId, grindOptionId])
  @@index([shopId])
}

/// Append-only stock history. The nightly reconciliation asserts
/// sum(deltaGrams) === stockOnHandGrams for every variant.
model StockLedger {
  id               String   @id @default(cuid())
  shopId           String
  variantId        String
  /// PURCHASE | SALE | RETURN | SPOILAGE | CORRECTION | RESERVATION | ...
  type             String
  deltaGrams       Int
  balanceAfterGrams Int
  reason           String?
  refType          String?
  refId            String?
  createdById      String?
  createdAt        DateTime @default(now())

  shop      Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdBy StoreUser? @relation("StockActor", fields: [createdById], references: [id])

  @@index([shopId, variantId, createdAt])
  @@index([shopId, createdAt])
}

// ---------------------------------------------------------------------------
// Slots
// ---------------------------------------------------------------------------

model DeliverySlot {
  id          String   @id @default(cuid())
  shopId      String
  type        String // DELIVERY | PICKUP | DROPOFF
  date        DateTime @db.Date
  startMinute Int
  endMinute   Int
  capacity    Int      @default(10)
  bookedCount Int      @default(0)
  cutoffAt    DateTime?
  isActive    Boolean  @default(true)

  shop   Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([shopId, type, date, startMinute])
  @@index([shopId, date, type])
}

/// In-presence milling reservations — the operator-capacity half of the
/// scheduling problem. Separate from DeliverySlot because it is consumed by a
/// machine, not a vehicle.
model MillSlot {
  id          String   @id @default(cuid())
  shopId      String
  date        DateTime @db.Date
  startMinute Int
  endMinute   Int
  capacity    Int      @default(1)
  bookedCount Int      @default(0)
  isActive    Boolean  @default(true)

  shop Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  jobs MillingJob[]

  @@unique([shopId, date, startMinute])
  @@index([shopId, date])
}

// ---------------------------------------------------------------------------
// Cart & orders
// ---------------------------------------------------------------------------

model Cart {
  id         String   @id @default(cuid())
  customerId String
  shopId     String
  status     String   @default("ACTIVE") // ACTIVE | CONVERTED | ABANDONED
  couponCode String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shop     Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items    CartItem[]

  // One active cart per customer per shop.
  @@index([customerId, shopId, status])
}

model CartItem {
  id               String @id @default(cuid())
  cartId           String
  shopId           String
  variantId        String
  quantity         Int    @default(1)
  grindOptionId    String?
  isSifted         Boolean?
  /// Materialized so a stale catalogue row cannot silently change the price.
  unitPricePaise   Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@index([cartId])
}

model Order {
  id           String @id @default(cuid())
  shopId       String
  orderNumber  String
  customerId   String

  /// ONE_TIME | CUSTOM_MILLING | SUBSCRIPTION
  type         String @default("ONE_TIME")
  /// DELIVERY | PICKUP
  fulfilment   String
  status       String @default("PENDING_PAYMENT")

  subtotalPaise          Int @default(0)
  promotionDiscountPaise Int @default(0)
  couponDiscountPaise    Int @default(0)
  deliveryDiscountPaise  Int @default(0)
  deliveryFeePaise       Int @default(0)
  taxPaise               Int @default(0)
  totalPaise             Int @default(0)

  couponId     String?
  couponCode   String?

  deliverySlotId String?
  pickupWindowId String?
  /// Short code verified at the counter for a pickup.
  pickupCode     String?

  /// The promise shown to the customer, frozen at confirmation.
  readyAtEstimate DateTime?
  /// Set once the order is actually ready.
  readyAt         DateTime?

  addressSnapshot Json?
  contactName     String?
  contactPhone    String?

  /// COD cash, recorded by whoever physically handed the goods over.
  codCollectedPaise Int?
  codCollectedById  String?
  codCollectedAt    DateTime?
  codVarianceNote   String?

  notes           String?
  internalNotes   String?
  /// Prevents a double-submit creating two orders.
  idempotencyKey  String?
  cancelledReason String?
  confirmedAt     DateTime?
  completedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop           Shop            @relation(fields: [shopId], references: [id])
  customer       Customer        @relation(fields: [customerId], references: [id])
  deliverySlot   DeliverySlot?   @relation(fields: [deliverySlotId], references: [id])
  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  millingJobs    MillingJob[]
  payments       Payment[]
  cashCollection CashCollection?
  ledgerEntries  LedgerEntry[]
  redemptions    CouponRedemption[]
  invoice        Invoice?
  subscriptionRun SubscriptionRun?

  @@unique([shopId, orderNumber])
  @@unique([shopId, id])
  @@unique([shopId, idempotencyKey])
  @@index([shopId, status, createdAt])
  @@index([shopId, customerId, createdAt])
  @@index([customerId, createdAt])
}

model OrderItem {
  id          String @id @default(cuid())
  shopId      String
  orderId     String
  variantId   String?
  /// Snapshots — an order must render identically years later.
  productName String
  variantLabel String
  packWeightGrams Int
  quantity    Int    @default(1)
  pricePerKgPaise Int
  unitPricePaise  Int
  lineTotalPaise  Int

  grindOptionId String?
  grindCode     String?
  siftChoice    String?

  /// Set when the milling job completes — powers the "milled on" badge.
  milledOn DateTime?

  createdAt DateTime @default(now())

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  grindOption GrindOption? @relation(fields: [grindOptionId], references: [id])
  millingJob  MillingJob?

  @@index([orderId])
  @@index([shopId, variantId])
}

model OrderStatusHistory {
  id        String   @id @default(cuid())
  shopId    String
  orderId   String
  fromStatus String?
  toStatus  String
  /// Polymorphic actor — never a cross-universe join.
  actorUniverse String @default("SYSTEM")
  actorId       String?
  actorLabel    String?
  reason        String?
  createdAt     DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([shopId, createdAt])
}

/// Per-shop atomic order numbering. Incremented with a single UPDATE.
model ShopSequence {
  shopId    String   @id
  nextOrder Int      @default(1)
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Milling
// ---------------------------------------------------------------------------

model MillingJob {
  id          String @id @default(cuid())
  shopId      String
  orderId     String
  orderItemId String @unique

  /// MILL_AHEAD | MILL_IN_PRESENCE
  mode        String @default("MILL_AHEAD")
  status      String @default("QUEUED")

  /// Customer-supplied grain for custom milling; null when shop stock is used.
  sourceGrain      String?
  isCustomerGrain  Boolean @default(false)
  orderedInputGrams Int
  actualInputGrams  Int?
  actualOutputGrams Int?
  yieldBps          Int?
  /// Charged when actual intake differs from the order beyond tolerance.
  priceAdjustmentPaise Int @default(0)

  varianceApprovedAt DateTime?
  varianceApprovedBy String?

  assignedToId String?
  millSlotId   String?
  shiftId      String?

  startedAt   DateTime?
  completedAt DateTime?
  cancelledReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  assignee  StoreUser? @relation("MillingAssignee", fields: [assignedToId], references: [id])
  millSlot  MillSlot? @relation(fields: [millSlotId], references: [id])
  shift     Shift?    @relation(fields: [shiftId], references: [id])

  @@index([shopId, status, createdAt])
  @@index([shopId, assignedToId, status])
  @@index([shopId, millSlotId])
}

// ---------------------------------------------------------------------------
// Payments & money
// ---------------------------------------------------------------------------

model Payment {
  id          String @id @default(cuid())
  shopId      String
  orderId     String
  provider    String // RAZORPAY | MANUAL | STUB
  method      String // COD | UPI | CARD | NETBANKING | WALLET
  status      String @default("CREATED")
  amountPaise Int

  providerOrderId   String?
  providerPaymentId String?
  providerSignature String?
  failureCode       String?
  failureReason     String?

  capturedAt DateTime?
  refundedPaise Int @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([provider, providerPaymentId])
  @@index([orderId])
  @@index([shopId, status, createdAt])
}

/// Inbound webhook bookkeeping. The unique (provider, eventId) is what makes
/// replaying a webhook a no-op instead of a double payment.
model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  eventType   String
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime @default(now())

  @@unique([provider, eventId])
  @@index([provider, processedAt])
}

/// Cash handed over at the counter or door. One row per collection event, so a
/// shortfall is traceable to the person who took the money.
model CashCollection {
  id           String @id @default(cuid())
  shopId       String
  orderId      String @unique
  amountPaise  Int
  expectedPaise Int
  collectedById String?
  shiftId      String?
  receiptNo    String?
  varianceNote String?
  /// Set when a refund reverses part of this collection.
  reversedByEntryId String?
  createdAt    DateTime @default(now())

  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  collectedBy StoreUser? @relation("CashCollector", fields: [collectedById], references: [id])
  shift       Shift?     @relation(fields: [shiftId], references: [id])

  @@index([shopId, createdAt])
  @@index([collectedById, createdAt])
}

/// A cash drawer session. Staff open a shift, collect through it, and the
/// admin attests the counted amount at close.
model Shift {
  id           String   @id @default(cuid())
  shopId       String
  openedById   String?
  openedAt     DateTime @default(now())
  closedAt     DateTime?
  countedPaise Int?
  depositRef   String?
  variancePaise Int?
  attestedById String?
  notes        String?

  shop       Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  collections CashCollection[]
  jobs       MillingJob[]
  entries    LedgerEntry[]

  @@index([shopId, closedAt])
}

/// Append-only. The source of truth for earnings and settlements — always a
/// sum over entries, never a read of mutable order rows. That is what makes
/// the number defensible in a franchise dispute.
model LedgerEntry {
  id         String @id @default(cuid())
  shopId     String
  entryType  String
  /// Signed: positive credits the shop, negative debits it.
  amountPaise Int
  orderId    String?
  paymentId  String?
  shiftId    String?
  /// Business-local date the entry belongs to, for day-close grouping.
  businessDate String
  occurredAt   DateTime @default(now())
  actorUniverse String  @default("SYSTEM")
  actorId      String?
  memo         String?

  shop    Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id])
  shift   Shift?  @relation(fields: [shiftId], references: [id])

  @@index([shopId, occurredAt])
  @@index([shopId, businessDate])
  @@index([orderId])
}

/// GST invoices. Serial numbers are unique per legal entity + series + fiscal
/// year, so shops sharing a GSTIN share one gapless series.
model Invoice {
  id            String @id @default(cuid())
  shopId        String
  orderId       String @unique
  legalEntityId String?
  financialYear String
  series        String
  serial        Int
  invoiceNumber String @unique
  /// Zero when the shop has no GST registration.
  taxPaise      Int    @default(0)
  cgstPaise     Int    @default(0)
  sgstPaise     Int    @default(0)
  igstPaise     Int    @default(0)
  totalPaise    Int
  issuedAt      DateTime @default(now())
  voidedAt      DateTime?

  shop        Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity? @relation(fields: [legalEntityId], references: [id])

  @@unique([legalEntityId, financialYear, series, serial])
  @@index([shopId, issuedAt])
}

// ---------------------------------------------------------------------------
// Marketing
// ---------------------------------------------------------------------------

model Banner {
  id         String @id @default(cuid())
  /// null = platform-wide (store picker, cross-shop campaigns).
  shopId     String?
  placement  String // HOME_HERO | HOME_STRIP | CATEGORY_TOP | CART_UPSELL
  imageKey   String
  headline   String?
  subhead    String?
  deepLink   String?
  sortOrder  Int    @default(0)
  status     String @default("DRAFT")
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  shop Shop? @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, placement, status])
  @@index([placement, status, startsAt])
}

/// One engine, two scopes: a null shopId is a platform-global coupon.
model Coupon {
  id        String  @id @default(cuid())
  shopId    String?
  code      String
  title     String?
  type      String // PERCENT | FLAT | FREE_DELIVERY
  /// bps for PERCENT, paise for FLAT, ignored for FREE_DELIVERY.
  value     Int
  maxDiscountPaise Int?
  minOrderPaise    Int @default(0)

  /// Who pays for the discount. Settlement nets it against this party.
  fundingParty String @default("STORE") // STORE | PLATFORM

  startsAt  DateTime?
  endsAt    DateTime?
  totalUsageLimit Int?
  totalUsed       Int @default(0)
  perCustomerLimit Int @default(1)
  firstOrderOnly   Boolean @default(false)

  applicableProductIds  String[] @default([])
  applicableCategoryIds String[] @default([])
  excludedProductIds    String[] @default([])

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop        Shop?            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  redemptions CouponRedemption[]

  // Codes are unique per shop; the global namespace cannot be colonized by a
  // store code because a NULL shopId participates in the same unique index.
  @@unique([shopId, code])
  @@index([code, isActive])
  @@index([shopId, isActive])
}

model CouponRedemption {
  id           String @id @default(cuid())
  shopId       String
  couponId     String
  customerId   String
  orderId      String
  discountPaise Int
  /// Set when the order cancels and the redemption is released.
  voidedAt     DateTime?
  createdAt    DateTime @default(now())

  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // The constraint that makes concurrent checkouts safe.
  @@unique([couponId, orderId])
  @@index([customerId, couponId])
  @@index([shopId, createdAt])
}

/// Code-free automatic discount on a category or product for a date range.
model Promotion {
  id          String  @id @default(cuid())
  shopId      String?
  title       String
  productId   String?
  categoryId  String?
  type        String // PERCENT | FLAT
  value       Int
  maxDiscountPaise Int?
  fundingParty String @default("STORE")
  startsAt    DateTime
  endsAt      DateTime
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())

  shop     Shop?    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([shopId, isActive, startsAt, endsAt])
}

// ---------------------------------------------------------------------------
// Subscriptions
// ---------------------------------------------------------------------------

model Subscription {
  id         String @id @default(cuid())
  shopId     String
  customerId String
  variantId  String?
  productName String

  grindCode  String?
  siftChoice String?
  packWeightGrams Int
  quantity    Int    @default(1)
  /// Frozen so a price change doesn't silently alter a recurring charge.
  lockedPricePerKgPaise Int

  interval    String // WEEKLY | BIWEEKLY | MONTHLY
  status      String @default("PENDING_MANDATE")
  billingMode String @default("PAYMENT_LINK") // RAZORPAY_MANDATE | PAYMENT_LINK | COD

  nextRunAt   DateTime
  startedAt   DateTime @default(now())
  pausedAt    DateTime?
  cancelledAt DateTime?
  failureCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  runs     SubscriptionRun[]

  @@index([status, nextRunAt])
  @@index([customerId])
  @@index([shopId])
}

/// One scheduled delivery of a subscription. Structurally idempotent via the
/// unique (subscriptionId, scheduledFor) — a re-fired cron tick finds the
/// existing run rather than creating a second order.
model SubscriptionRun {
  id             String @id @default(cuid())
  subscriptionId String
  shopId         String
  runNumber      Int
  scheduledFor   DateTime
  status         String @default("SCHEDULED")
  orderId        String? @unique
  amountPaise    Int?
  attemptCount   Int    @default(0)
  lastError      String?
  fulfilledAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  order        Order?       @relation(fields: [orderId], references: [id])

  @@unique([subscriptionId, scheduledFor])
  @@unique([subscriptionId, runNumber])
  @@index([status, scheduledFor])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// Append-only, hash-chained. The app's DB role has INSERT-only grants on this
/// table in production. Denied capability checks are logged too — a burst of
/// denials is the signal something is probing.
model AuditLog {
  id            String   @id @default(cuid())
  actorUniverse String // PLATFORM | STORE | CUSTOMER | SYSTEM
  actorId       String?
  actorRole     String?
  actorLabel    String?
  shopId        String?
  action        String
  resourceType  String?
  resourceIds   String[] @default([])
  before        Json?
  after         Json?
  reasonCode    String?
  requestId     String?
  ip            String?
  userAgent     String?
  outcome       String   @default("ALLOWED") // ALLOWED | DENIED
  /// SHA-256 of (prevHash + canonical row content) — tamper-evident chain.
  prevHash      String?
  hash          String
  createdAt     DateTime @default(now())

  @@index([actorUniverse, actorId, createdAt])
  @@index([shopId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

/// Time-boxed elevation for sensitive reads (e.g. revealing customer PII).
model SupportGrant {
  id         String @id @default(cuid())
  userId     String
  capability String
  targetType String?
  targetId   String?
  reason     String
  ticketRef  String?
  grantedById String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([userId, capability, expiresAt])
}
