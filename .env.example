# ---------------------------------------------------------------------------
# Database (local docker compose uses port 5433 to avoid clashing with a
# system Postgres). In production: Neon ap-south-1 pooled URL in DATABASE_URL,
# unpooled in DIRECT_URL.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://grain:grain@localhost:5433/grain_basket?schema=public"
DIRECT_URL="postgresql://grain:grain@localhost:5433/grain_basket?schema=public"

APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Three identity universes. These MUST all be different — the app asserts it
# at boot. Generate each with: openssl rand -base64 32
# ---------------------------------------------------------------------------
CUSTOMER_AUTH_SECRET="dev-customer-secret-change-me-0000000000000000"
STORE_AUTH_SECRET="dev-store-secret-change-me-000000000000000000"
PLATFORM_AUTH_SECRET="dev-platform-secret-change-me-000000000000000"

# Cookie prefixes are derived from these; changing them logs everyone out.
CUSTOMER_COOKIE_PREFIX="gb_customer"
STORE_COOKIE_PREFIX="gb_store"
PLATFORM_COOKIE_PREFIX="gb_platform"

# ---------------------------------------------------------------------------
# Dev convenience
# ---------------------------------------------------------------------------
# console | msg91  — console prints the OTP to the server log
SMS_TRANSPORT="console"
# Shows customer OTP in the login response. NEVER enable in production.
OTP_DEV_ECHO="true"

# ---------------------------------------------------------------------------
# Payments (Phase 4) — leave blank to run COD-only
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Shared secret for /api/cron/* so the sweep can't be triggered publicly.
CRON_SECRET="dev-cron-secret-change-me"
